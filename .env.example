# -----------------------------------------------------------------------------
# General Personal Agent defaults
# - DB: general_personal_agent (separate from v1)
# - port: 8100; frontend planned /gpa/wb/
# - OV/MA: dev baseline may share existing resources; replace with dedicated resources
#   before production. Keep MEMORY_ENABLED/WB_SUMMARY_TO_OV false until then.
# -----------------------------------------------------------------------------

# =============================================================================
# 语音 Agent Demo（方案 B）· 环境变量
# -----------------------------------------------------------------------------
# 填写说明：
#   1) 标 [必填] 的项必须由你提供，留空会导致对应链路启动失败；
#   2) 标 [默认] 的项已给可用值，一般不用改；
#   3) 标 [预留] 的项一期不启用，保持默认即可；
#   4) 本文件只放本地，不要提交到任何仓库（含真实 Key）。
# 对应文档：Demo方案B_最终方案_v1.0.md 第 12 节
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 应用基础
# -----------------------------------------------------------------------------
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8100
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://127.0.0.1:8100

# [已生成] Cookie 签名密钥；如需更换：openssl rand -hex 32
APP_SECRET_KEY=

# -----------------------------------------------------------------------------
# 2. 火山方舟 / 对话模型
# -----------------------------------------------------------------------------
# [必填] 方舟 API Key（控制台 → API Key 管理）
# 注：此处预填的是此前本地评测用过的 key，可直接使用或替换成你的 Key。
ARK_API_KEY=

# [默认] 方舟 OpenAPI 地址（不要带 /systemone 后缀）
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# [必填] 三段式的对话脑；如已建推理接入点，填 ep-xxxx 亦可
MODEL_AGENT_NAME=deepseek-v4-1-flash-261017

# [默认] 生成参数：关闭深度思考以压低首响
MODEL_AGENT_THINKING=disabled
MODEL_AGENT_TEMPERATURE=0.3
MODEL_AGENT_MAX_TOKENS=2048

# -----------------------------------------------------------------------------
# 3. 语音（豆包 ASR / TTS）
# -----------------------------------------------------------------------------
# [必填] 火山语音控制台 → 应用管理 → AppID / Access Token
TOOL_VESPEECH_APP_ID=
TOOL_VESPEECH_API_KEY=

# [默认] ASR 集群与地址（双向流式优化版）
TOOL_VESPEECH_CLUSTER=volcengine_streaming_common
ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
ASR_SAMPLE_RATE=16000
ASR_CHUNK_MS=200
# 判停静音阈值；越小首响越快、越容易截断
ASR_VAD_SILENCE_MS=400
# 是否开启二遍识别（提升准确率，增加延迟）
ASR_ENABLE_NONSTREAM=false

# [必填] TTS 音色（控制台音色列表里的 voice_type）
TOOL_VESPEECH_SPEAKER=zh_female_vv_uranus_bigtts
TOOL_VESPEECH_SPEED_RATIO=1.0

# [默认] TTS WebSocket 流式地址与参数
# 优先尝试 unidirectional；当前 appid/token 会被拒，自动回退到 bidirection（同样单向收发）
TTS_WS_URL=wss://openspeech.bytedance.com/api/v3/tts/unidirectional/stream
TTS_WS_FALLBACK_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection
TTS_RESOURCE_ID=seed-tts-2.0
# HTTP v1 合成仍用于日期快答缓存与流式失败兜底
# TTS 的 cluster 固定 volcano_tts；不要用上面 ASR 的 cluster
TTS_CLUSTER=volcano_tts
TTS_SAMPLE_RATE=24000
# 首句最大字数；越小首包越快
TTS_MAX_SENTENCE_CHARS=20

# -----------------------------------------------------------------------------
# 4. OpenViking（上下文面）
# -----------------------------------------------------------------------------
# [已填] 火山托管服务固定接入点（北京）；这是 OpenViking 服务地址，不是控制台看到的“库 ID”
OV_URL=https://api.vikingdb.cn-beijing.volces.com/openviking

# [默认] account = 租户/环境边界；托管服务由控制台分配，实测当前账号为 default
# 换企业版独立实例后再改 demo-prod；api_key 模式下该值只用于日志与 URI 拼接
OV_ACCOUNT=default
OV_TENANT_ID=demo

# [必填] ROOT / ADMIN / 每个用户的 user key
# ROOT 只给管理脚本用；ADMIN 用于建用户和管管理员知识库；
# USER key 由 bootstrap 脚本写入 Postgres 的 key_ref，运行时按需取用。
#
# ⚠️ 当前火山托管实例实测：
#    1) /api/v1/admin/* 与 /api/v1/acl 均返回 403 ApiBlocked，users 只能在控制台建；
#    2) 普通 user 对 viking://resources/admin 仍有写权限（默认 user:* = manage），
#       管理员 KB 的“只读”必须由后端收口（仅 admin 角色可写），不能依赖平台 ACL。
#    三把 key 已按 default/Alice/Bob 填好，数据面 /fs、/search、/sessions 正常。
OV_ROOT_KEY=
OV_ADMIN_KEY=
OV_USER_KEY_ADMIN=
OV_USER_KEY_ALICE=
OV_USER_KEY_BOB=

# [已按控制台对齐] 控制台“用户管理”现有 default(管理员)/Alice/Bob；用户 ID 即 URI 里的 {uid}
# 说明：文中示例写作 u_alice/u_bob/u_admin，实际以本组值为准
OV_ADMIN_GROUP=knowledge-admins
OV_USER_ALICE=Alice
OV_USER_BOB=Bob
OV_USER_ADMIN=default
OV_PEER_ALICE=device_alice
OV_PEER_BOB=device_bob
OV_IDENTITY_TABLE=ov_identity

# [默认] OV 目录布局（实现见 gpa/context/layout.py）
# 共享库就是 viking://resources 本身：管理员写、所有人读；不建 admin/ 或 shared/ 角色子目录。
# 个人文档写入 user/<u>/resources/uploads/，任务卡写入 resources/artifacts/。
# 留空 = 检索整个 scope；配置后读写收窄到指定索引/分类：
#   OV_PERSONAL_KB_INDEXES=uploads,artifacts
#   OV_SHARED_KB_CATEGORIES=hr,ops    # 仅在需要主题分类时设置
OV_PERSONAL_KB_INDEXES=
OV_SHARED_KB_CATEGORIES=
# 是否把 agent/skills 与 user/<u>/skills 的技能摘要注入上下文
OV_SKILLS_ENABLED=true

# [默认] 认证模式：api_key / trusted / oidc / dev（禁止 dev）
OV_AUTH_MODE=api_key

# [默认] 上下文组装预算与超时
OV_TIMEOUT_S=30.0
OV_SESSION_BUDGET_TOKENS=4000
OV_KB_BUDGET_TOKENS=2000
OV_SEARCH_TOP_K=8
OV_ADMIN_CACHE_TTL_S=600
# 首响后上下文的 P95 预算，仅用于埋点告警
OV_CONTEXT_P95_BUDGET_MS=500

# -----------------------------------------------------------------------------
# 4.5 V0.5 上下文引擎（A3/A12）——两阶段并行 + 意图等待 + Step 0 指代消解
# -----------------------------------------------------------------------------
# 引擎开关：off=旧 assemble；shadow=双跑对比（旧路径回答）；on=新引擎回答
CONTEXT_ENGINE_V2=off
# Step 0 条件指代消解（计入 Phase B 预算）
CONTEXT_STEP0_MS=40
CONTEXT_PHASE_A_MS=150
CONTEXT_PHASE_B_MS=450
# 总 deadline（t0 起算；总耗时 ≈ max(A,B)+merge）
CONTEXT_TOTAL_MS=500
# 渲染硬上限（估算 token；1 字 ≈ 0.75 token，待 S7 校准）
CONTEXT_TOKEN_BUDGET=2000
# 逐路超时（ms）
OV_TIMEOUT_SESSION_MS=100
OV_TIMEOUT_MEMORY_MS=250
OV_TIMEOUT_PERSONAL_MS=300
OV_TIMEOUT_SHARED_MS=300
CONTEXT_TRACE_TTL_DAYS=7

# A1 稳定会话：30 分钟窗口内重连复用 conversation_id；STM 用 Postgres（agent_stm schema）
CONVERSATION_IDLE_MIN=30
AGENT_STM_BACKEND=postgresql
AGENT_STM_SCHEMA=agent_stm

# A4 Outbox：进程内 sweeper，指数退避 1s/5s/30s/2m/10m，超限进死信
OUTBOX_INTERVAL_S=1.0
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=8

# B 记忆：每 2 轮（4 条消息）自动 commit；短会话可在会话页手动保存
MEMORY_ENABLED=true
MEMORY_COMMIT_EVERY=2
MEMORY_CARD_TTL_S=300

# C 个人 KB：TOS 原件先行 + OV 异步索引；sha256 幂等；配额 200 篇
PERSONAL_KB_V2=true
KB_QUOTA_DOCS=200
KB_INDEX_TIMEOUT_S=120

# -----------------------------------------------------------------------------
# 5. 登录态（Demo 简化实现）
# -----------------------------------------------------------------------------
SESSION_COOKIE_NAME=gpa_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_MIN=720
# [已生成] Demo 登录 PIN（三个用户共用；生产替换为真实 SSO）
DEMO_LOGIN_PIN=

# -----------------------------------------------------------------------------
# 6. Postgres / Redis（状态面）
# -----------------------------------------------------------------------------
# [必填] 精确 transcript、任务状态、ov_identity 映射
DATABASE_URL=postgresql+asyncpg://demo:demo@127.0.0.1:5432/general_personal_agent

# [必填] 短期缓存、幂等键
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_TTL_SESSION_S=1800

# -----------------------------------------------------------------------------
# 7. Managed Agents（任务面）
# -----------------------------------------------------------------------------
# [必填] 方舟 MA 控制台 → Agent ID / Environment ID
# 不要提交真实资源 ID：填写你自己的 agent-xxx / env-xxx
MA_AGENT_ID=
MA_ENVIRONMENT_ID=

# [默认] 会话使用的 Agent 版本；0 = 跟随 MA 上的当前版本（推荐）。
# 固定旧版本会让会话缺少后续新增的工具（如图像/视频生成），不要随意填 1。
MA_AGENT_VERSION=0

# [默认] MA 接口地址；API Key 留空则复用 ARK_API_KEY
MA_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MA_API_KEY=

# [默认] 任务后端：ma / local；local 走内置 ppt_generate 兜底
TASK_BACKEND=ma
TASK_LOCAL_FALLBACK=true
TASK_MAX_RETRY=2
TASK_TIMEOUT_S=300
TASK_ARTIFACT_TTL_DAYS=7
# MA 报 idle 后产物可能延迟注册，等待窗口内继续轮询 /files
TASK_ARTIFACT_GRACE_S=15
MA_POLL_INTERVAL_S=2

# -----------------------------------------------------------------------------
# 8. 对象存储 TOS（产物面）
# -----------------------------------------------------------------------------
# [必填] 火山引擎统一凭证：TOS、VeADK web_search 共用这一套
# 需要权限：TOS 读写 + volc_torchlight_api:WebSearch
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=
# 仅 STS 临时凭证才需要；长期 AK/SK 留空
# 过期后 TOS 上传与联网搜索会同时失败，重新签发后更新本行。
# 注意：同名环境变量优先于 .env；若曾在 shell 里 export VOLCENGINE_*，
# 轮换后要同步 export，或先 unset 再启动，否则进程仍会用旧的一组。
VOLCENGINE_SESSION_TOKEN=

# [必填] 桶名与地域
MA_TOS_BUCKET=
DATABASE_TOS_BUCKET_NAME=
DATABASE_TOS_REGION=cn-beijing

# [默认] 端点、签名有效期、对象前缀
TOS_ENDPOINT=https://tos-cn-beijing.volces.com
TOS_SIGNED_URL_TTL_S=3600
TOS_PREFIX=general-personal-agent

# -----------------------------------------------------------------------------
# 9. 搜索（ark / veadk_web_search）
# -----------------------------------------------------------------------------
# 默认使用哪种：ark / veadk_web_search
SEARCH_PROVIDER=veadk_web_search
SEARCH_COUNT=5
SEARCH_TIMEOUT_S=60
SEARCH_CACHE_TTL_S=300
# Agent 工具回传给模型的摘要上限（字符），避免整页网页撑爆上下文
SEARCH_SUMMARY_MAX_CHARS=1500
# 主 provider 失败后的兜底（逗号分隔、按序尝试；留空关闭兜底）
SEARCH_FALLBACK_PROVIDERS=ark
# 单次 provider 尝试超时 / 同一 provider 尝试次数 / 重试退避
SEARCH_ATTEMPT_TIMEOUT_S=15
SEARCH_RETRY_ATTEMPTS=2
SEARCH_RETRY_BACKOFF_S=0.4
# 一轮搜索（含兜底与重试）的总预算
SEARCH_BUDGET_S=30

# veadk_web_search 复用第 8 节的 VOLCENGINE_ACCESS_KEY / SECRET_KEY / SESSION_TOKEN
# 不再单独维护搜索密钥；切到 veadk_web_search 即可
# 注意：VOLCENGINE_* 是 STS 临时凭据，会过期。进程内命中鉴权错误时会自动重读
# .env 并重试一次，仍失败则走 SEARCH_FALLBACK_PROVIDERS 兜底；`/health` 的
# gpa.web_search.last / credentials 可确认进程当前持有的是哪一代凭据。

# -----------------------------------------------------------------------------
# 10. WorkBuddy / 豆包工作（预留，一期不启用）
# -----------------------------------------------------------------------------
WORKBUDDY_ENABLED=false
WORKBUDDY_BASE_URL=
WORKBUDDY_TOKEN=
WORKBUDDY_AGENT_ID=

# -----------------------------------------------------------------------------
# 11. 知识库
# -----------------------------------------------------------------------------
KB_MAX_FILE_MB=20
KB_IMPORT_POLL_INTERVAL_S=2
KB_IMPORT_TIMEOUT_S=180
KB_ALLOWED_EXTS=.pdf,.md,.docx,.txt,.html,.json,.yaml,.yml,.png,.jpg,.jpeg

# -----------------------------------------------------------------------------
# 12. 观测与演示
# -----------------------------------------------------------------------------
METRICS_ENABLED=true
DEMO_MODE=true
# 演示用三个账号（登录页展示）
DEMO_USERS=alice,bob,admin
# 演示后是否自动清理临时对象（仅 demo 环境）
DEMO_CLEANUP_ON_EXIT=false

# -----------------------------------------------------------------------------
# 13. 助手工作台（workbench，设计附录 B）
# -----------------------------------------------------------------------------
# 仅支持 monitor；legacy/gray 已移除（启动会拒绝）
TASK_EXECUTOR=monitor
# gray 模式逐用户白名单（app_user 逗号分隔）
# monitor kill switch：停止认领新会话（在途自然结算，不中断）
WB_MONITOR_PAUSED=false
# 实时车道轮询间隔（秒）
WB_MONITOR_INTERVAL_S=2
# 缓慢车道（迟到产物/自管副本重试）
WB_SLOW_INTERVAL_S=30
# 维护车道（过期材料/TTL 清理/僵尸恢复）
WB_MAINTENANCE_INTERVAL_S=60
# running 总超时护栏（秒；含 Ark 排队时间，实测生图任务 3-6 分钟）
WB_TURN_TIMEOUT_S=600
# 产物自管副本（下载/预览/复用走 own_tos_key）
WB_ARTIFACT_COPY=true
# turn 摘要回写 OV 记忆树
WB_SUMMARY_TO_OV=true
# 播报摘要生成器模型（空=模板降级：首句≤20字、≤2句）
WB_SUMMARY_MODEL=
# SSE 鉴权重校验周期（秒）
WB_SSE_RECHECK_S=60
# 平台 Agent 列表 JSON（空则取 MA_AGENT_ID）
WB_PLATFORM_AGENTS=
# wb_change / wb_notification TTL（天）
WB_CHANGE_TTL_DAYS=30
WB_NOTIFICATION_TTL_DAYS=90
# ma_session_event 归档阈值（天；0=关闭；仅终态会话）
WB_EVENT_ARCHIVE_DAYS=180
# 自动化调度引擎开关
WB_AUTOMATIONS_ENABLED=true

# -----------------------------------------------------------------------------
# 14. GPA-native core（P1 conversation/agent/context）
# -----------------------------------------------------------------------------
# auto: 有 ARK key + MODEL_AGENT_NAME 时使用 VeADK，否则使用开发桩；veadk/stub 可强制
GPA_AGENT_MODE=auto
# ContextManagerPlugin（ADK BasePlugin）开关
GPA_CONTEXT_MANAGER=true
# 进程启动后用一次极短模型调用预热 LiteLLM/ARK，避免首个用户轮次冷启动
GPA_WARMUP_ENABLED=true
# 向 Agent 暴露 search_memory / search_knowledge 工具
GPA_CONTEXT_TOOLS_ENABLED=true
# 无 turn 的 draft 会话保留天数；启动与后台巡检会清理
GPA_DRAFT_TTL_DAYS=7
# draft 清理巡检间隔（秒）
GPA_DRAFT_PURGE_INTERVAL_S=21600
GPA_REDIS_URL=
GPA_RATE_LIMIT_MESSAGES_PER_MIN=30
GPA_RATE_LIMIT_WS_PER_MIN=10
GPA_RATE_LIMIT_LOGIN_PER_MIN=30
GPA_RATE_LIMIT_DOWNLOADS_PER_MIN=60
# 内部任务网关 service token；为空时 /api/internal/* 返回 503
GPA_SERVICE_TOKEN=
GPA_SERVICE_TOKEN_PREVIOUS=
# 生产由 KMS/Secrets Manager 注入；本地可留空只用静态 token
GPA_SERVICE_JWT_SECRET=
GPA_SERVICE_JWT_PREVIOUS_SECRET=
# KMS/secret manager 可挂载文件，优先生效于空 secret
GPA_SERVICE_JWT_SECRET_FILE=
GPA_SERVICE_JWT_PREVIOUS_SECRET_FILE=
GPA_SERVICE_TOKEN_TTL_S=900
# MCP OAuth client credentials
GPA_OAUTH_CLIENT_ID=
GPA_OAUTH_CLIENT_SECRET=
GPA_RATE_LIMIT_OAUTH_PER_MIN=10
# OAuth token 可代操作的用户，逗号分隔；为空则 token 不能代表任何用户
GPA_OAUTH_ALLOWED_USERS=alice,bob
# 文本/语音上下文装配预算（毫秒）
GPA_TEXT_BUDGET_MS=800
GPA_VOICE_BUDGET_MS=400
# 语音轮先播一句缓存 filler（查天气/建任务等慢意图），盖住等待空窗
GPA_VOICE_FILLER_ENABLED=true
# 单轮总时长护栏（秒）
GPA_TURN_TIMEOUT_S=60
GPA_RUNTIME_TTL_S=1800
GPA_RUNTIME_MAX_SESSIONS=200
# TaskEventInbox 轮询间隔/批量
GPA_INBOX_INTERVAL_S=2
GPA_INBOX_BATCH_SIZE=50

# ---- 文件上传 / 知识库 ----
GPA_FILES_ENABLED=true
GPA_KB_ENABLED=true
GPA_KB_SHARED_WRITE_ENABLED=true
# off | internal | percent | all（请求级执行；internal 走 allowlist/admin）
GPA_FILES_ROLLOUT=all
GPA_FILES_ALLOWLIST=
GPA_FILES_ROLLOUT_PERCENT=0
GPA_FILE_MAX_MB=50
GPA_FILE_MAX_PER_MESSAGE=10
GPA_CONVERSATION_QUOTA_MB=200
GPA_FILE_EXTRACT_TIMEOUT_S=120
GPA_FILE_EXTRACT_WORKERS=2
GPA_FILE_EXTRACT_MEMORY_MB=512
GPA_FILE_READ_WAIT_MS=1500
GPA_FILE_GC_RETENTION_DAYS=7
GPA_FILE_ORPHAN_HOURS=24
GPA_FILE_JOB_INTERVAL_S=1
GPA_FILE_JOB_BATCH_SIZE=10
GPA_KB_PRIVATE_QUOTA_MB=2048
GPA_KB_SHARED_QUOTA_MB=10240
